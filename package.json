{
  "name": "@celading/pihub",
  "version": "0.4.0",
  "description": "Local-first web panel for the pi coding agent — streaming chat, session trees, cost insights, pipelines; everything on your machine",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && npm run lint && vite build && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "start": "node dist-server/server/index.js",
    "showcase:record": "node scripts/record-showcase.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@fontsource/ibm-plex-serif": "^5.2.6",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "puppeteer-core": "^25.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "bin": {
    "pihub": "dist-server/server/index.js"
  },
  "files": [
    "dist",
    "dist-server",
    "README.md",
    "README-CN.md",
    "MANUAL.md",
    "MANUAL.zh-CN.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "pi",
    "coding-agent",
    "agent",
    "web-panel",
    "local-first",
    "chat-ui",
    "llm"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HapPub/PiHub.git"
  },
  "homepage": "https://github.com/HapPub/PiHub",
  "engines": {
    "node": ">=20"
  }
}
